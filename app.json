{
  "expo": {
    "name": "Wrocław Transit",
    "slug": "wroclaw-transit",
    "scheme": "wroclawtransit",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.ocidburn.wroclawtransit",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#F4F5F7",
          "dark": {
            "backgroundColor": "#0E1013"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Чтобы показать на карте, где вы, и остановки рядом.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      "./plugins/without-push-entitlement",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ]
    ],
    "platforms": [
      "ios"
    ]
  }
}
