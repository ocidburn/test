  "dependencies": {
    "expo": "~58.0.16",
    "expo-constants": "~58.0.12",
    "expo-dev-client": "~58.0.14",
    "expo-file-system": "~58.0.10",
    "expo-linking": "~58.0.13",
    "expo-location": "~58.0.18",
    "expo-notifications": "~58.1.5",
    "expo-router": "~58.0.24",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.10",
    "expo-sqlite": "~58.0.13",
    "expo-status-bar": "~58.0.3",
    "expo-system-ui": "~58.0.6",
    "fflate": "^0.8.3",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-maps": "1.29.11",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.88.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "@types/sql.js": "^1.4.11",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "gtfs-realtime-bindings": "^1.1.1",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.11",
    "patch-package": "^8.0.1",
    "react-dom": "^19.3.0",
    "react-test-renderer": "^19.3.0",
    "sql.js": "^1.15.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "postinstall": "patch-package",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "test": "jest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "lint": "expo lint",
    "bench:import": "jest --testMatch \"**/perf.manual.ts\""
  },
  "private": true,
  "jest": {
    "preset": "jest-expo/node",
    "roots": [
      "<rootDir>/test"
    ],
    "testMatch": [
      "**/*.test.ts"
    ]
  }
