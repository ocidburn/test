+//
+//  AIRMapTileFallbackRenderer.h
+//  AirMaps
+//
+//  Patched in by Wrocław Transit (patches/react-native-maps+1.29.11.patch).
+//
+
+#import <MapKit/MapKit.h>
+
+/**
+ * MKTileOverlayRenderer leaves an empty square (MapKit's grey grid, when the
+ * overlay replaces the map) until the tile of the new zoom level has loaded.
+ * This one draws what the overlay's tile cache already holds for that place
+ * meanwhile: coarser tiles scaled up, finer ones scaled down. Then the real
+ * tile replaces it as before.
+ */
+@interface AIRMapTileFallbackRenderer : MKTileOverlayRenderer
+@end
diff --git a/node_modules/react-native-maps/ios/AirMaps/AIRMapTileFallbackRenderer.m b/node_modules/react-native-maps/ios/AirMaps/AIRMapTileFallbackRenderer.m
